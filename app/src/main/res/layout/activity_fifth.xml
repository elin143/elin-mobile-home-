<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sage_background"
    tools:context=".Home.pertemuan_5.FifthActivity">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/sage_toolbar"
            app:layout_scrollFlags="scroll|enterAlways"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@android:color/white"
            app:icon="@drawable/ic_info"
            app:iconGravity="textStart"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Konten scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Button: Web View Portal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebView"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Buka Web Portal Berita Desa"
                android:textColor="@color/sage_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sage_primary"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_message"
                app:iconGravity="textStart"
                app:iconTint="@color/sage_on_primary"
                android:layout_marginBottom="16dp" />

            <!-- Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warta &amp; Kabar Desa Terkini"
                android:textSize="18sp"
                android:textColor="@color/sage_on_primary_container"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- News 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rapat Koordinasi Anggaran Pemeliharaan Aset"
                        android:textStyle="bold"
                        android:textColor="@color/sage_on_primary_container"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pemerintah desa mengadakan rapat koordinasi untuk membahas alokasi anggaran pemeliharaan gedung balai pertemuan desa dan inventarisasi komputer baru."
                        android:textColor="@color/sage_on_surface_variant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Program Renovasi Jalan &amp; Saluran Irigasi Barat"
                        android:textStyle="bold"
                        android:textColor="@color/sage_on_primary_container"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Proyek perbaikan jalan setapak beton dan jembatan irigasi sektor barat desa Villagio akan dimulai bulan depan menggunakan bantuan dana alokasi desa."
                        android:textColor="@color/sage_on_surface_variant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Penambahan Unit Mobil Ambulans Baru Posyandu"
                        android:textStyle="bold"
                        android:textColor="@color/sage_on_primary_container"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pusat layanan kesehatan desa menerima tambahan unit ambulans operasional guna mempercepat penanganan medis darurat warga setempat."
                        android:textColor="@color/sage_on_surface_variant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News 4 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pelatihan Sistem Pengelolaan Aset Digital Villagio"
                        android:textStyle="bold"
                        android:textColor="@color/sage_on_primary_container"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Perangkat staf administrasi mengikuti pelatihan bimbingan teknis penggunaan aplikasi inventaris Villagio demi keterbukaan pendataan aset lokal."
                        android:textColor="@color/sage_on_surface_variant"
                        android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>