<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sage_background"
    tools:context=".RegistrasiActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Branding -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:layout_marginTop="24dp"
            android:contentDescription="Villagio Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Akun"
            android:textSize="24sp"
            android:textColor="@color/sage_on_primary_container"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrasi Administrator Aset Desa Villagio"
            android:textSize="13sp"
            android:textColor="@color/sage_outline"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"/>

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/sage_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Label & Input Nama -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_primary"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/nama"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Masukkan Nama Lengkap"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Label & Input Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_primary"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Masukkan Username"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Label & Input No HP -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nomor Handphone"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_primary"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/nomorHp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Masukkan Nomor HP"
                    android:inputType="phone"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Label & Input Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi (Password)"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_primary"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/Password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Masukkan Password"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:layout_marginBottom="24dp" />

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Daftar Sekarang"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/sage_on_primary"
                    app:backgroundTint="@color/sage_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Back to Login Link -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sudah punya akun? Masuk disini"
            android:textColor="@color/sage_primary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>