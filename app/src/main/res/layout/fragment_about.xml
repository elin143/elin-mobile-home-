<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sage_toolbar"
        app:title=""
        app:titleTextColor="@android:color/white" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sage_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Logo & Name Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/logo"
                    android:contentDescription="Villagio Logo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Villagio"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/sage_on_primary_container"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistem Inventarisasi Aset Desa"
                    android:textSize="14sp"
                    android:textColor="@color/sage_outline"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versi 1.0.0"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"/>
            </LinearLayout>

            <!-- Card: Deskripsi -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/sage_primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tentang Villagio"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/sage_on_primary_container"
                            android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Villagio adalah aplikasi inventarisasi digital yang dirancang untuk mempermudah perangkat desa dalam mengelola, memantau, dan mendata aset desa secara terstruktur dan efisien."
                        android:textSize="14sp"
                        android:textColor="@color/sage_on_surface_variant"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Tujuan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/sage_primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tujuan &amp; Manfaat"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/sage_on_primary_container"
                            android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Membantu transparansi pengelolaan kekayaan desa.\n• Memudahkan pengawasan kondisi fisik aset secara real-time.\n• Mempercepat pemeliharaan sarana dan prasarana umum desa."
                        android:textSize="14sp"
                        android:textColor="@color/sage_on_surface_variant"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Fitur -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_home"
                            app:tint="@color/sage_primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fitur Utama"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/sage_on_primary_container"
                            android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✔ Manajemen Data Aset (CRUD)\n✔ Pencatatan Kategori, Lokasi, dan Kondisi\n✔ Room Database untuk Keamanan Data Lokal\n✔ Antarmuka Pengguna Sage Green yang Nyaman"
                        android:textSize="14sp"
                        android:textColor="@color/sage_on_surface_variant"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Panduan Penggunaan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/sage_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingin Tahu Cara Penggunaan?"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/sage_on_primary_container"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pelajari langkah awal penggunaan aplikasi Villagio melalui tutorial singkat kami."
                        android:textSize="13sp"
                        android:textColor="@color/sage_outline"
                        android:textAlignment="center"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartTutorial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mulai Tutorial"
                        android:textColor="@color/sage_on_primary"
                        app:backgroundTint="@color/sage_primary"
                        app:cornerRadius="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>