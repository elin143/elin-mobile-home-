<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F4"
    android:fillViewport="true"
    tools:context=".Home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#1E3A27"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Villagio • Inventaris Aset Desa"
            android:textColor="#BADBAE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="@+id/headerBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4" />

        <TextView
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistem Manajemen &amp; Monitoring Aset Digital"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@+id/textView6"
            app:layout_constraintStart_toStartOf="@+id/textView6"
            android:layout_marginTop="4dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/btnAset"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="-30dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/sage_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerBackground">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/iconAsetContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#DDE5D3"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        app:tint="@color/sage_primary"
                        android:contentDescription="Asset Icon" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/titleAset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconAsetContainer"
                    android:layout_marginStart="16dp"
                    android:text="Kelola Inventaris Aset Desa"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconAsetContainer"
                    android:layout_below="@id/titleAset"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Pendataan, Pemeliharaan &amp; CRUD Aset"
                    android:textColor="#E1E4D7"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnWebView"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAset">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <View
                    android:id="@+id/iconWebView"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#BADBAE"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/titleWebView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconWebView"
                    android:layout_marginStart="16dp"
                    android:text="Portal Web Villagio"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconWebView"
                    android:layout_below="@id/titleWebView"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Akses dashboard &amp; data inventaris desa via web"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnWebView">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <View
                    android:id="@+id/icon5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#BADBAE"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/title5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon5"
                    android:layout_marginStart="16dp"
                    android:text="Informasi &amp; Berita Desa"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon5"
                    android:layout_below="@id/title5"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Akses portal berita dan pengumuman resmi desa"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="@+id/btn5"
            app:layout_constraintStart_toStartOf="@+id/btn5"
            app:layout_constraintTop_toBottomOf="@+id/btn5">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <View
                    android:id="@+id/icon9"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#BADBAE"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/title9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon9"
                    android:layout_marginStart="16dp"
                    android:text="Pengingat Pemeliharaan Aset"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon9"
                    android:layout_below="@id/title9"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Jadwalkan alarm &amp; notifikasi pengecekan aset rutin"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn10"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="@+id/btn9"
            app:layout_constraintStart_toStartOf="@+id/btn9"
            app:layout_constraintTop_toBottomOf="@+id/btn9">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <View
                    android:id="@+id/icon10"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#BADBAE"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/title10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon10"
                    android:layout_marginStart="16dp"
                    android:text="Katalog Estimasi Aset"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon10"
                    android:layout_below="@id/title10"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Lihat daftar katalog visual estimasi aset desa"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn13"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="@+id/btn10"
            app:layout_constraintStart_toStartOf="@+id/btn10"
            app:layout_constraintTop_toBottomOf="@+id/btn10">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <View
                    android:id="@+id/icon13"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#BADBAE"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@+id/title13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon13"
                    android:layout_marginStart="16dp"
                    android:text="Scan &amp; QR Kode Aset"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon13"
                    android:layout_below="@id/title13"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Pindai QR barcode, foto, dan buat QR aset"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnKalkulator"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="@+id/btn13"
            app:layout_constraintStart_toStartOf="@+id/btn13"
            app:layout_constraintTop_toBottomOf="@+id/btn13">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/iconKalkulatorContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#DDE5D3"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_calculator"
                        app:tint="@color/sage_primary"
                        android:contentDescription="Calculator Icon" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/titleKalkulator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconKalkulatorContainer"
                    android:layout_marginStart="16dp"
                    android:text="Kalkulator Penyusutan Aset"
                    android:textStyle="bold"
                    android:textColor="#1E3A27"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconKalkulatorContainer"
                    android:layout_below="@id/titleKalkulator"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Hitung nilai sisa &amp; rekomendasi tindakan aset"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnlogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/textView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.9"
            app:layout_constraintStart_toEndOf="@+id/textView6"
            app:layout_constraintTop_toTopOf="@+id/textView6" />

        <TextView
            android:id="@+id/lblGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Galeri &amp; Log Aset Terbaru"
            android:textColor="#1E3A27"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@+id/btnKalkulator"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/lblGallery" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>