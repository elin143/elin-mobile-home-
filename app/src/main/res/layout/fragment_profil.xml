<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BADBAE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Developer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A"
            android:layout_gravity="center"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informasi pengembang aplikasi"
            android:textSize="14sp"
            android:textColor="#57043D"
            android:layout_marginTop="4dp"
            android:layout_gravity="center"/>

        <!-- Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <!-- Card Profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <!-- Nama -->
            <TextView
                android:text="Nama"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0D1B2A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Eveline Cantika Gabriela"
                android:textSize="14sp"
                android:textColor="#555"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- NIM -->
            <TextView
                android:text="NIM"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0D1B2A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="2457301041"
                android:textSize="14sp"
                android:textColor="#555"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Kelas -->
            <TextView
                android:text="Kelas"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#0D1B2A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="2 SI A"
                android:textSize="14sp"
                android:textColor="#555"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>