<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sage_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Avatar & Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardCornerRadius="44dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/sage_primary_container">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profil"
                    app:tint="@color/sage_primary"
                    android:contentDescription="Profile Avatar" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil Developer"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/sage_on_primary_container"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informasi pengembang aplikasi Villagio"
                android:textSize="13sp"
                android:textColor="@color/sage_outline"
                android:layout_marginTop="2dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- Card 1: Kartu Identitas Pengembang -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/sage_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_account"
                        app:tint="@color/sage_primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identitas Akademik"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/sage_on_primary_container"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/sage_divider"
                    android:layout_marginBottom="12dp"/>

                <!-- Nama -->
                <TextView
                    android:text="Nama Lengkap"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Eveline Cantika Gabriela"
                    android:textSize="15sp"
                    android:textColor="@color/sage_on_primary_container"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- NIM -->
                <TextView
                    android:text="Nomor Induk Mahasiswa (NIM)"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="2457301041"
                    android:textSize="15sp"
                    android:textColor="@color/sage_on_primary_container"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Kelas -->
                <TextView
                    android:text="Kelas / Angkatan"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="2 SI A"
                    android:textSize="15sp"
                    android:textColor="@color/sage_on_primary_container"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: Kontribusi Proyek Villagio -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/sage_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/sage_primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kontribusi Proyek Villagio"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/sage_on_primary_container"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/sage_divider"
                    android:layout_marginBottom="12dp"/>

                <!-- Peran -->
                <TextView
                    android:text="Peran dalam Proyek"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Lead Developer &amp; System Analyst"
                    android:textSize="14sp"
                    android:textColor="@color/sage_on_primary_container"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Kontribusi Detail -->
                <TextView
                    android:text="Deskribusi Kontribusi"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/sage_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✔ Merancang skema database lokal menggunakan SQLite dan Room Database.\n✔ Mengatur arsitektur navigasi utama dan pengelolaan State Fragment.\n✔ Mengimplementasikan bahasa visual bertema Sage Green untuk menyelaraskan tampilan aplikasi dengan identitas kelestarian desa."
                    android:textSize="13sp"
                    android:textColor="@color/sage_on_surface_variant"
                    android:lineSpacingMultiplier="1.2"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>